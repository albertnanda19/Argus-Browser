{
  "name": "argus",
  "version": "0.1.0",
  "private": true,
  "description": "Argus desktop shell",
  "main": "dist/node/electron/main.js",
  "scripts": {
    "dev": "npm run build:node && node scripts/dev.mjs",
    "build": "npm run clean && npm run build:node && npm run build:renderer",
    "clean": "node scripts/clean.mjs",
    "build:node": "tsc -p tsconfig.node.json",
    "build:renderer": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "hono": "4.13.13",
    "node-stream-zip": "1.16.0",
    "playwright-core": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "45.0.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
