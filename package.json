{
  "name": "argus",
  "version": "0.1.0",
  "private": true,
  "description": "Argus desktop shell",
  "main": "dist/node/electron/main.js",
  "scripts": {
    "dev": "npm run build:node && node scripts/dev.mjs",
    "providers:configure": "node scripts/configure-providers.mjs",
    "build": "npm run clean && npm run build:node && npm run build:renderer",
    "clean": "node scripts/clean.mjs",
    "build:node": "tsc -p tsconfig.node.json",
    "build:renderer": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke:browser": "npm run build:node && node dist/node/backend/scripts/smoke-browser.js",
    "smoke:attach": "npm run build:node && node dist/node/backend/scripts/smoke-attach.js",
    "smoke:act": "npm run build:node && node dist/node/backend/scripts/smoke-act.js",
    "smoke:input": "npm run build:node && node dist/node/backend/scripts/smoke-input.js",
    "smoke:stealth": "npm run build:node && node dist/node/backend/scripts/smoke-stealth.js",
    "smoke:cdp-gateway": "npm run build:node && node dist/node/backend/scripts/smoke-cdp-gateway.js",
    "smoke:cdp-lifecycle": "npm run build:node && node dist/node/backend/scripts/smoke-cdp-lifecycle.js"
  },
  "dependencies": {
    "@browserbasehq/stagehand": "4.3.0",
    "@hono/node-server": "2.1.5",
    "hono": "4.13.13",
    "node-stream-zip": "1.16.0",
    "playwright-core": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "electron": "45.0.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
